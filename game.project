[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1

[android]
input_method = HiddenInputField

[project]
title = musou2d
version = 0.1.0
dependencies#0 = https://github.com/defold/extension-spine/archive/refs/tags/4.8.0.zip

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[physics]
gravity_y = 0.0
scale = 0.02
